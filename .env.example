# Copy this file to `.env` and fill in your values. `.env` is git-ignored - do not commit real secrets.
# Azure services (Voice Live, AI Search, SQL) use Microsoft Entra ID via DefaultAzureCredential:
#   - locally: `az login` (or VS Code Azure sign-in)
#   - in Azure: the app's managed identity (set AZURE_CLIENT_ID for a user-assigned identity)

# --- Azure Voice Live API (Microsoft Foundry resource) ---
# The Foundry resource endpoint, e.g. https://<resource>.cognitiveservices.azure.com or https://<resource>.services.ai.azure.com
AZURE_VOICE_LIVE_ENDPOINT="https://<your-foundry-resource>.cognitiveservices.azure.com"
AZURE_VOICE_LIVE_API_VERSION="2026-04-10"
VOICE_LIVE_MODEL="gpt-realtime-2.1"
# Azure TTS voice used for the spoken response (HD voices recommended)
AZURE_TTS_VOICE_NAME="en-IN-Meera:DragonHDV2.3Neural"
# AZURE_TTS_VOICE_TEMPERATURE=0.8
# Input transcription: gpt-4o-transcribe | gpt-4o-mini-transcribe | whisper-1 | mai-transcribe
INPUT_TRANSCRIPTION_MODEL="gpt-4o-transcribe"

# --- Optional: turn detection / cough & noise robustness tuning (defaults shown) ---
# VAD_TYPE="azure_semantic_vad"
# VAD_THRESHOLD=0.6
# VAD_PREFIX_PADDING_MS=300
# VAD_SPEECH_DURATION_MS=300
# VAD_SILENCE_DURATION_MS=700
# VAD_REMOVE_FILLER_WORDS=true
# INTERRUPT_DEBOUNCE_MS=450

# --- Optional: Entra ID ---
# AZURE_CLIENT_ID="<client-id-of-user-assigned-managed-identity>"

# --- Atlassian Jira Cloud (grievances) - API token ---
attlassian_api_key = ''
attlassian_user_name = ''
attlassian_url = 'https://nnnnnnn.atlassian.net/'
grievance_project_key = ''
grievance_type = 'Task'
grievance_project_name = ''

# --- Azure AI Search (Entra ID; identity needs 'Search Index Data Reader') ---
ai_search_url = "https://nnnnnn.search.windows.net"
ai_index_name = "contoso-insurance-faq-index"
ai_semantic_config = "contoso-insurance-faq-config"

# --- Azure SQL Database (Entra ID; identity must be a database user with db_datareader) ---
az_db_server = "xxxxxx.database.windows.net"
az_db_database = "cdcsampledb"
# az_db_driver = "ODBC Driver 18 for SQL Server"
# Login timeout in seconds (generous so cold starts in Azure Container Apps don't fail the first query)
# az_db_connection_timeout = 60

# Customer the assistant is talking to; claim lookups are always restricted to this patient
customer_name = "Srikantan"

# --- Optional: persona and UI ---
# Gender of the assistant persona; must match the TTS voice (Meera is female). Controls first-person
# grammar in Hindi and other gendered languages ("मैं कर सकती हूँ" vs "मैं कर सकता हूँ").
# ASSISTANT_GENDER="female"
# Open the solution configuration side panel automatically when a chat starts (default: collapsed)
# SHOW_CONFIG_PANEL_ON_START=false
